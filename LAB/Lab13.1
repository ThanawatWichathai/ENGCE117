#include <stdio.h>

int* KnapsackDP( int *w, int *v, int n, int wx ) ;

int main() {
    int n = 5, wx = 11 ;
    int w[5] = {1, 2, 5, 6, 7};
    int v[5] = {1, 6, 18, 22, 28} ;

    int *x;
    x = KnapsackDP(w, v, n, wx);

    for( int i = 0 ; i < n ; i++ )
        printf( "%d " , x[i] ) ;

    return 0 ;
}// end function

int* KnapsackDP(int *w, int *v, int n, int wx) {

    int **K = new int*[n+1] ;
    for(int i = 0; i <= n; i++)
        K[i] = new int[wx+1] ;

    for( int i = 0; i <= n; i++ ) {
        for( int j = 0; j <= wx; j++ ) {

            if( i == 0 || j == 0 )
                K[i][j] = 0 ;

            else if(w[i-1] <= j) {

                int include = v[i-1] + K[i-1][ j - w[i-1] ] ;
                int exclude = K[i-1][j] ;

                K[i][j] = ( include > exclude ) ? include : exclude ;
            }// end if
            else
                K[i][j] = K[i-1][j] ;
        }// end for
    }// end for

    int *x = new int[n] ;
    for( int i = 0; i < n; i++ )
        x[i] = 0 ;

    int i = n ;
    int j = wx ;

    while(i > 0 && j > 0) {

        if( K[i][j] != K[i-1][j] ) {
            x[i-1] = 1 ;
            j -= w[i-1] ;
        }// end if
        i-- ;
    }// end while

    return x ;
}// end function
